  - "\u4E3B\u89D2"
  dialogueLines:
  - "\u96F7\u2026\u2026"
  - "\u9192\u4E86\uFF1F"
  - "\u90A3\u679A\u7B26\u6587\u2026\u2026\u7ADF\u53C8\u56DE\u5230\u4EBA\u985E\u624B\u4E2D\u3002"
  - "\u4F60\u8A8D\u5F97\u96F7\u75D5\u7B26\u6587\u3002"
  - "\u6211\u600E\u6703\u5FD8\u8A18\u3002"
  - "\u90A3\u9053\u96F7\u5288\u958B\u6211\u7684\u7532\uFF0C\u90A3\u7FA4\u87BB\u87FB\u7528\u5C4D\u9AD4\u5835\u4F4F\u6211\u7684\u8DEF\u3002\u4F60\u5011\u7684\u5148\u7956\uFF0C\u628A\u6B7B\u4EA1\u5806\u6210\u7246\uFF0C\u624D\u63DB\u4F86\u6211\u9000\u56DE\u6B64\u5730\u3002"
  - "\u807D\u8D77\u4F86\u4F60\u8A18\u5F97\u5F88\u6E05\u695A\u3002"
  - "\u6211\u5728\u9ED1\u6697\u4E2D\u8A18\u4E86\u5F88\u591A\u5E74\u3002"
  - "\u90A3\u4F60\u61C9\u8A72\u4E5F\u8A18\u5F97\u81EA\u5DF1\u70BA\u4EC0\u9EBC\u88AB\u8A0E\u4F10\u3002"
  - "\u56E0\u70BA\u6211\u5F37\u3002"
  - "\u56E0\u70BA\u4F60\u5C60\u6751\u3002"
