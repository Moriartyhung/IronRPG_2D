--- !u!114 &326565589
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 326565587}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4c8f9662b6d36b542981bfddbd9c970f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueInteraction
  speakerName: "\u6751\u9577"
  interactPrompt: "\u6309 E \u8207\u6751\u9577\u4EA4\u8AC7"
  useDialogueSequences: 1
  dialogueSequences:
  - sequenceName: "\u7B2C\u4E00\u6B21\u627E\u6751\u9577"
    requiredQuestStage: 0
    speakerName: "\u6751\u9577"
    interactPrompt: "\u6309 E \u8207\u6751\u9577\u4EA4\u8AC7"
    useSpeakerLines: 1
    speakerLines:
    - speakerName: "\u6751\u9577"
      text: "\u4F60\u56DE\u4F86\u4E86\u3002\u4ECA\u5929\u6BD4\u5E73\u5E38\u665A\u4E9B\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6211\u5728\u907A\u8DE1\u9047\u5230\u4E86\u5C0F\u602A\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u5C0F\u602A\uFF1F\u5728\u907A\u8DE1\uFF1F"
    - speakerName: "\u4E3B\u89D2"
      text: "\u662F\u3002\u4E0D\u662F\u91CE\u7378\uFF0C\u4E5F\u4E0D\u50CF\u666E\u901A\u8FF7\u8DEF\u7684\u9B54\u7269\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u4F60\u78BA\u5B9A\u662F\u5728\u796D\u58C7\u9644\u8FD1\uFF1F"
    - speakerName: "\u4E3B\u89D2"
      text: "\u78BA\u5B9A\u3002\u6211\u525B\u796D\u62DC\u5B8C\u5148\u7956\uFF0C\u6E96\u5099\u56DE\u6751\uFF0C\u5B83\u5C31\u5F9E\u77F3\u7246\u5F8C\u9762\u947D\u51FA\u4F86\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u2026\u2026"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6751\u9577\uFF0C\u4F60\u81C9\u8272\u4E0D\u592A\u597D\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u56E0\u70BA\u4F60\u4E0D\u662F\u4ECA\u5929\u7B2C\u4E00\u500B\u5E36\u4F86\u58DE\u6D88\u606F\u7684\u4EBA\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u9084\u6709\u8AB0\u9047\u5230\u602A\u7269\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u6751\u88E1\u5E7E\u500B\u5E74\u8F15\u4EBA\uFF0C\u4ECA\u5929\u65E9\u4E0A\u53BB\u68EE\u6797\u63A1\u96C6\u6728\u6750\u548C\u85E5\u8349\u3002\u7D50\u679C\u4ED6\u5011\u5728\u68EE\u6797\u5916\u570D\u9047\u5230\u5927\u91CF\u5C0F\u602A\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u5927\u91CF\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u4E0D\u662F\u4E00\u5169\u96BB\u3002\u662F\u6210\u7FA4\u51FA\u73FE\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4ED6\u5011\u53D7\u50B7\u4E86\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u6709\u5E7E\u500B\u88AB\u6293\u50B7\uFF0C\u9084\u6709\u4EBA\u6454\u65B7\u4E86\u817F\u3002\u5E78\u597D\u4ED6\u5011\u8DD1\u5F97\u5FEB\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u68EE\u6797\u5916\u570D\u4EE5\u524D\u9802\u591A\u6709\u91CE\u72FC\u548C\u86C7\uFF0C\u4E0D\u6703\u6709\u5C0F\u602A\u7FA4\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u6240\u4EE5\u9019\u5341\u5206\u4E0D\u5C0D\u52C1\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4F60\u89BA\u5F97\u907A\u8DE1\u548C\u68EE\u6797\u7684\u7570\u5E38\u6709\u95DC\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u6211\u4E0D\u6562\u65B7\u5B9A\uFF0C\u4F46\u6211\u4E0D\u559C\u6B61\u5DE7\u5408\u3002\u5C24\u5176\u662F\u9019\u7A2E\u6703\u50B7\u4EBA\u7684\u5DE7\u5408\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u9700\u8981\u6211\u53BB\u68EE\u6797\u770B\u770B\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u5148\u4E0D\u8981\u6025\u8457\u9032\u68EE\u6797\u6DF1\u8655\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u70BA\u4EC0\u9EBC\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u4F60\u9700\u8981\u66F4\u591A\u60C5\u5831\u3002\u53BB\u9152\u9928\u627E\u90A3\u4E9B\u56DE\u4F86\u7684\u5E74\u8F15\u4EBA\uFF0C\u4ED6\u5011\u73FE\u5728\u90FD\u5728\u90A3\u88E1\u990A\u50B7\u548C\u58D3\u9A5A\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4F60\u6C92\u554F\u904E\u4ED6\u5011\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u554F\u904E\uFF0C\u4F46\u4ED6\u5011\u8AAA\u8A71\u541E\u541E\u5410\u5410\u3002\u6709\u4EBA\u8AAA\u770B\u898B\u5BF6\u5149\uFF0C\u6709\u4EBA\u8AAA\u807D\u898B\u543C\u8072\uFF0C\u9084\u6709\u4EBA\u4E00\u63D0\u5230\u68EE\u6797\u6DF1\u8655\u5C31\u4F4E\u982D\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u807D\u8D77\u4F86\u4ED6\u5011\u96B1\u779E\u4E86\u4EC0\u9EBC\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u6240\u4EE5\u6211\u8B93\u4F60\u53BB\u554F\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6211\u53BB\u554F\uFF0C\u4ED6\u5011\u5C31\u6703\u8AAA\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u4F60\u8DDF\u4ED6\u5011\u5E74\u7D00\u8FD1\u3002\u4ED6\u5011\u6015\u6211\uFF0C\u4F46\u672A\u5FC5\u6015\u4F60\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u9019\u8A71\u807D\u8D77\u4F86\u4E0D\u50CF\u8A87\u734E\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u9019\u4E0D\u662F\u8A87\u734E\uFF0C\u662F\u4EFB\u52D9\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u660E\u767D\u4E86\u3002\u6211\u53BB\u9152\u9928\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u8A18\u4F4F\uFF0C\u5148\u554F\u6E05\u695A\u3002\u4E0D\u8981\u81EA\u5DF1\u4E00\u982D\u947D\u9032\u68EE\u6797\u6DF1\u8655\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6211\u6703\u5C0F\u5FC3\u3002"
    dialogueLines: []
    setObjectiveOnComplete: 1
    objectiveTextOnComplete: "\u524D\u5F80\u9152\u9928\uFF0C\u8A62\u554F\u53D7\u50B7\u7684\u5E74\u8F15\u4EBA"
    advanceQuestStageOnComplete: 1
    questStageOnComplete: 1
  - sequenceName: "\u56DE\u5831\u6D1E\u7A74\u7DDA\u7D22"
    requiredQuestStage: 2
    speakerName: "\u6751\u9577"
    interactPrompt: "\u6309 E \u5411\u6751\u9577\u56DE\u5831"
    useSpeakerLines: 1
    speakerLines:
    - speakerName: "\u6751\u9577"
      text: "\u4F60\u56DE\u4F86\u4E86\u3002\u554F\u51FA\u4EC0\u9EBC\u4E86\uFF1F"
    - speakerName: "\u4E3B\u89D2"
      text: "\u68EE\u6797\u6DF1\u8655\u6709\u5BF6\u5149\uFF0C\u63A5\u8457\u50B3\u4F86\u5DE8\u543C\uFF0C\u7136\u5F8C\u5C0F\u602A\u5F9E\u56DB\u9762\u516B\u65B9\u51FA\u73FE\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u5BF6\u5149\u2026\u2026\u5DE8\u543C\u2026\u2026"
    - speakerName: "\u4E3B\u89D2"
      text: "\u9084\u6709\u4E00\u4EF6\u4E8B\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u8AAA\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u90A3\u4E9B\u5E74\u8F15\u4EBA\u4E0A\u500B\u6708\u53BB\u904E\u6D1E\u7A74\u9580\u53E3\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u2026\u2026\u4F60\u518D\u8AAA\u4E00\u6B21\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4ED6\u5011\u6C92\u6709\u9032\u6D1E\u7A74\uFF0C\u4F46\u5728\u6D1E\u53E3\u6253\u9B27\uFF0C\u9084\u671D\u88E1\u9762\u558A\u53EB\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u80E1\u9B27\uFF01"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4ED6\u5011\u8AAA\u6D1E\u88E1\u6709\u56DE\u61C9\uFF0C\u50CF\u662F\u6709\u5DE8\u5927\u7684\u6771\u897F\u5728\u7FFB\u8EAB\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u6211\u65E9\u5C31\u8AAA\u904E\uFF0C\u4EFB\u4F55\u4EBA\u4E0D\u5F97\u9760\u8FD1\u90A3\u5EA7\u6D1E\u7A74\uFF01"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4ED6\u5011\u6015\u4F60\u751F\u6C23\uFF0C\u6240\u4EE5\u6C92\u6562\u8AAA\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u751F\u6C23\uFF1F\u4ED6\u5011\u4EE5\u70BA\u6211\u53EA\u662F\u751F\u6C23\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u90A3\u5EA7\u6D1E\u7A74\u4E0D\u662F\u7528\u4F86\u8003\u9A57\u81BD\u91CF\u7684\u5730\u65B9\uFF0C\u4E0D\u662F\u5E74\u8F15\u4EBA\u5C55\u793A\u611A\u8822\u7684\u821E\u53F0\uFF01"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6751\u9577\uFF0C\u6D1E\u7A74\u88E1\u5230\u5E95\u6709\u4EC0\u9EBC\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u2026\u2026"
    - speakerName: "\u4E3B\u89D2"
      text: "\u73FE\u5728\u68EE\u6797\u548C\u907A\u8DE1\u90FD\u51FA\u73FE\u602A\u7269\u3002\u5982\u679C\u6D1E\u7A74\u4E5F\u6709\u554F\u984C\uFF0C\u6211\u9700\u8981\u77E5\u9053\u771F\u76F8\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u4F60\u8AAA\u5F97\u5C0D\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u90A3\u5EA7\u6D1E\u7A74\uFF0C\u662F Boss \u7684\u5DE2\u7A74\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "Boss\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u5F88\u4E45\u4EE5\u524D\uFF0C\u5B83\u5F9E\u6D1E\u7A74\u6DF1\u8655\u51FA\u73FE\uFF0C\u8972\u64CA\u5468\u570D\u6751\u838A\u3002\u5B83\u71D2\u6BC0\u7CE7\u5009\uFF0C\u541E\u98DF\u7272\u755C\uFF0C\u6BBA\u6B7B\u5916\u51FA\u7684\u4EBA\u3002\u90A3\u6642\u5019\uFF0C\u9019\u9644\u8FD1\u6C92\u6709\u4E00\u500B\u6751\u5B50\u80FD\u5B89\u7761\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6211\u5011\u7684\u5148\u7956\u4E5F\u53C3\u8207\u4E86\u8A0E\u4F10\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u4E0D\u53EA\u662F\u53C3\u8207\u3002\u4F60\u7684\u5148\u7956\u662F\u53EC\u96C6\u8005\u4E4B\u4E00\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6211\u53EA\u807D\u904E\u5148\u7956\u5B88\u8B77\u6751\u5B50\u7684\u50B3\u8AAA\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u50B3\u8AAA\u7E3D\u6703\u628A\u8840\u8165\u7684\u90E8\u5206\u7701\u7565\u3002\u771F\u5BE6\u60C5\u6CC1\u662F\uFF0C\u9644\u8FD1\u5E7E\u500B\u6751\u5B50\u5E7E\u4E4E\u628A\u6240\u6709\u80FD\u62FF\u6B66\u5668\u7684\u4EBA\u90FD\u6D3E\u4E86\u51FA\u53BB\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u7D50\u679C\u5462\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u4ED6\u5011\u91CD\u50B7\u4E86 Boss\uFF0C\u903C\u5B83\u9000\u56DE\u6D1E\u7A74\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6BBA\u4E0D\u6B7B\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u6BBA\u4E0D\u6B7B\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u70BA\u4EC0\u9EBC\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u64DA\u8AAA\u90A3\u500B Boss \u76AE\u7CD9\u8089\u539A\uFF0C\u5C31\u7B97\u662F\u6253\u78E8\u904E\u7684\u5229\u5203\u90FD\u7121\u6CD5\u50B7\u5176\u5206\u6BEB\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u90A3\u5148\u7956\u662F\u600E\u9EBC\u91CD\u50B7\u5B83\u7684\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u6C92\u4EBA\u77E5\u9053\u3002\u90A3\u4E00\u6230\u6D3B\u4E0B\u4F86\u7684\u4EBA\u5F88\u5C11\u3002\u7559\u4E0B\u4F86\u7684\u7D00\u9304\u4E5F\u6B98\u7F3A\u4E0D\u5168\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6240\u4EE5\u4F60\u624D\u7981\u6B62\u4EFB\u4F55\u4EBA\u9760\u8FD1\u6D1E\u7A74\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u56E0\u70BA\u6709\u4E9B\u5371\u96AA\u4E0D\u662F\u52C7\u6562\u5C31\u80FD\u89E3\u6C7A\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4F46\u73FE\u5728\u5B83\u53EF\u80FD\u6B63\u5728\u9192\u4F86\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u4E5F\u53EF\u80FD\u5DF2\u7D93\u88AB\u4EC0\u9EBC\u6771\u897F\u9A5A\u52D5\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u90A3\u4E9B\u5E74\u8F15\u4EBA\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u4ED6\u5011\u611A\u8822\uFF0C\u4F46\u672A\u5FC5\u6709\u90A3\u9EBC\u5927\u672C\u4E8B\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u68EE\u6797\u6DF1\u8655\u7684\u5BF6\u5149\u5462\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u6211\u4E0D\u77E5\u9053\u3002\u4F46\u5BF6\u5149\u3001\u602A\u7269\u3001\u6D1E\u7A74\u8072\u97FF\uFF0C\u540C\u6642\u51FA\u73FE\uFF0C\u7D55\u4E0D\u6B63\u5E38\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "如果普通刀劍傷不了 Boss，那我們需要能把力量導入拳掌的東西。"
    - speakerName: "\u6751\u9577"
      text: "傳下來的說法很少。只知道當年討伐隊靠的不是鐵刃，而是一種能引動雷電的古老符文。"
    - speakerName: "\u4E3B\u89D2"
      text: "提到符文和鍛造，就不得不想到村口的那位武器匠。"
    - speakerName: "\u6751\u9577"
      text: "\u4F60\u662F\u8AAA\u9435\u7827\u90A3\u500B\u8001\u9811\u56FA\uFF1F"
    - speakerName: "\u4E3B\u89D2"
      text: "他們家世世代代都在打造拳套和刻印符文。也許他知道些什麼。"
    - speakerName: "\u6751\u9577"
      text: "\u4ED6\u8AAA\u81EA\u5DF1\u7956\u4E0A\u9023\u5929\u90FD\u6562\u6572\u3002\u90A3\u6642\u6211\u4EE5\u70BA\u4ED6\u53EA\u662F\u559D\u591A\u4E86\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4E5F\u8A31\u4E0D\u662F\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u53BB\u554F\u554F\u4ED6\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u5982\u679C\u4ED6\u77E5\u9053\u4EC0\u9EBC\uFF0C\u6211\u6703\u56DE\u4F86\u544A\u8A34\u4F60\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u9084\u6709\u4E00\u4EF6\u4E8B\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4EC0\u9EBC\uFF1F"
    - speakerName: "\u6751\u9577"
      text: "\u5982\u679C\u4F60\u771F\u7684\u8981\u9032\u68EE\u6797\uFF0C\u5148\u6D3B\u8457\u56DE\u4F86\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6211\u6703\u3002"
    - speakerName: "\u6751\u9577"
      text: "\u9019\u4E0D\u662F\u73A9\u7B11\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6211\u77E5\u9053\u3002"
    dialogueLines: []
    setObjectiveOnComplete: 1
    objectiveTextOnComplete: "前往武器鋪，詢問拳套與符文情報"
    advanceQuestStageOnComplete: 1
    questStageOnComplete: 3
