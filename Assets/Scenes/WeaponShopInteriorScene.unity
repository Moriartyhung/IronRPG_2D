--- !u!114 &1720340523
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1720340521}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4c8f9662b6d36b542981bfddbd9c970f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NpcDialogueInteraction
  speakerName: "\u6B66\u5668\u5320"
  interactPrompt: "\u6309 E \u8207\u6B66\u5668\u5320\u4EA4\u8AC7"
  useDialogueSequences: 1
  dialogueSequences:
  - sequenceName: "\u7B2C\u4E00\u6B21\u627E\u6B66\u5668\u5320"
    requiredQuestStage: 3
    speakerName: "\u6B66\u5668\u5320"
    interactPrompt: "\u6309 E \u8207\u6B66\u5668\u5320\u4EA4\u8AC7"
    useSpeakerLines: 1
    speakerLines:
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u55B2\uFF0C\u4ECA\u5929\u5439\u4EC0\u9EBC\u98A8\uFF1F\u7375\u4EBA\u4E0D\u53BB\u68EE\u6797\uFF0C\u8DD1\u4F86\u770B\u9435\uFF1F"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6751\u9577\u8B93\u6211\u4F86\u554F\u4F60\u4E00\u4E9B\u4E8B\u3002"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u5982\u679C\u662F\u4FEE\u67F5\u6B04\uFF0C\u6211\u4E0D\u53BB\u3002\u4E0A\u6B21\u6211\u4FEE\u5B8C\uFF0C\u4ED6\u5011\u8AAA\u6211\u628A\u9580\u505A\u5F97\u592A\u91CD\uFF0C\u63A8\u4E0D\u958B\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4E0D\u662F\u67F5\u6B04\uFF0C\u662F\u62F3\u5957\u548C\u7B26\u6587\u3002"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u90A3\u5012\u50CF\u53E5\u4EBA\u8A71\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6751\u9577\u8AAA\uFF0C\u6D1E\u7A74\u88E1\u7684 Boss \u76AE\u7CD9\u8089\u539A\uFF0C\u666E\u901A\u653B\u64CA\u50B7\u4E0D\u4E86\u5B83\u3002"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u6751\u9577\u7D42\u65BC\u628A\u90A3\u8001\u6545\u4E8B\u7FFB\u51FA\u4F86\u4E86\uFF1F"
    - speakerName: "\u4E3B\u89D2"
      text: "\u90A3\u6709\u6C92\u6709\u8FA6\u6CD5\u50B7\u5230\u90A3\u500B Boss\uFF1F"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u666E\u901A\u62F3\u5957\u4E0D\u884C\u3002\u4F4E\u968E\u7B26\u6587\u4E5F\u53EA\u662F\u8B93\u5B83\u89BA\u5F97\u7662\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u53F2\u8A69\u7B26\u6587\u5462\uFF1F"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u80FD\u6253\u5F97\u52D5\u5F37\u602A\uFF0C\u4F46\u8981\u8AAA\u5C0D\u4ED8\u6D1E\u7A74\u88E1\u90A3\u6771\u897F\uFF0C\u9084\u5DEE\u5F97\u9060\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u90A3\u4EC0\u9EBC\u624D\u884C\uFF1F"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u96F7\u75D5\u7B26\u6587\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4F60\u771F\u7684\u77E5\u9053\u9019\u7A2E\u6771\u897F\uFF1F"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u77E5\u9053\uFF0C\u56E0\u70BA\u6211\u5011\u5BB6\u66FE\u7D93\u6253\u9020\u904E\u80FD\u627F\u53D7\u7B26\u6587\u7684\u62F3\u5957\u3002"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u96F7\u75D5\u7B26\u6587\u88E1\u7559\u4E0B\u4E86\u96F7\u3002\u4E0D\u662F\u666E\u901A\u96F7\u5149\uFF0C\u662F\u80FD\u6495\u958B\u539A\u7532\u548C\u9B54\u76AE\u7684\u5929\u96F7\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u5B83\u73FE\u5728\u5728\u54EA\uFF1F"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u5931\u8E64\u4E86\u5F88\u591A\u5E74\u3002\u50B3\u8AAA\u90A3\u679A\u7B26\u6587\u6703\u8A8D\u4E3B\u3002\u5B83\u4E0D\u670D\u61E6\u5F31\u7684\u4EBA\uFF0C\u4E5F\u4E0D\u670D\u8CAA\u5A6A\u7684\u4EBA\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u600E\u9EBC\u627E\u5230\u5B83\uFF1F"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u5B83\u6703\u5B9A\u671F\u767C\u51FA\u4E94\u8272\u971E\u5149\uFF0C\u5438\u5F15\u4EBA\u53BB\u5F81\u670D\u5B83\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u9152\u9928\u7684\u5E74\u8F15\u4EBA\u8AAA\uFF0C\u68EE\u6797\u6DF1\u8655\u6709\u5BF6\u5149\u3002\u4ED6\u5011\u8AAA\u90A3\u5149\u50CF\u5BF6\u77F3\uFF0C\u53C8\u50CF\u9727\uFF0C\u6709\u5F88\u591A\u984F\u8272\u3002"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u90A3\u4E0D\u662F\u666E\u901A\u5BF6\u7269\uFF0C\u5F88\u53EF\u80FD\u5C31\u662F\u96F7\u75D5\u7B26\u6587\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u5982\u679C\u90A3\u679A\u7B26\u6587\u80FD\u50B7 Boss\uFF0C\u6211\u5FC5\u9808\u627E\u5230\u5B83\u3002"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u4F60\u53EF\u4EE5\u53BB\u627E\uFF0C\u4F46\u5225\u4EE5\u70BA\u770B\u5230\u5149\u5C31\u7B49\u65BC\u5B83\u5C6C\u65BC\u4F60\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u68EE\u6797\u88E1\u6709\u5927\u91CF\u5C0F\u602A\uFF0C\u6DF1\u8655\u53EF\u80FD\u9084\u6709\u66F4\u5F37\u7684\u6771\u897F\u3002"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u90A3\u4F60\u624B\u4E0A\u7684\u666E\u901A\u62F3\u5957\u548C\u4F4E\u968E\u7B26\u6587\u4E0D\u5920\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4F60\u6709\u66F4\u597D\u7684\u88DD\u5099\uFF1F"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u6709\u4E00\u679A\u53F2\u8A69\u7B26\u6587\uFF0C\u540D\u5B57\u53EB\u300E\u8D64\u92D2\u7B26\u6587\u300F\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u5B83\u80FD\u6253\u7CBE\u82F1\u602A\uFF1F"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u5982\u679C\u914D\u4E0A\u7CBE\u9435\u62F3\u5957\uFF0C\u5B83\u80FD\u9707\u788E\u786C\u9AA8\u3002\u7576\u7136\uFF0C\u60F3\u62FF\u5B83\u6253\u6D1E\u7A74
        Boss\uFF0C\u9084\u662F\u4E0D\u5920\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6211\u73FE\u5728\u53EF\u80FD\u8CB7\u4E0D\u8D77\u3002"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u90A3\u5C31\u53BB\u68EE\u6797\u6E05\u5C0F\u602A\uFF0C\u64BF\u91D1\u5E63\uFF0C\u8CE3\u6389\u6389\u843D\u88DD\u5099\u3002\u4F60\u4E0D\u662F\u7375\u4EBA\u55CE\uFF1F\u8CFA\u9322\u9019\u7A2E\u4E8B\u4E5F\u8981\u6211\u6559\uFF1F"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6211\u5148\u53BB\u68EE\u6797\u770B\u770B\u3002"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u5982\u679C\u4F60\u771F\u7684\u770B\u5230\u96F7\u75D5\u7B26\u6587\uFF0C\u4E0D\u8981\u6025\u8457\u4F38\u624B\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u70BA\u4EC0\u9EBC\uFF1F"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u4E0D\u88AB\u627F\u8A8D\u7684\u4EBA\uFF0C\u78B0\u5B83\u4E0D\u662F\u53D6\u5F97\u529B\u91CF\uFF0C\u662F\u62DB\u96F7\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4F60\u9019\u8A71\u5F88\u6709\u8AAA\u670D\u529B\uFF0C\u7562\u7ADF\u4F60\u7956\u5148\u5C31\u662F\u9019\u6A23\u6B7B\u7684\u3002"
    - speakerName: "\u6B66\u5668\u5320"
      text: "\u2026\u2026\u6EFE\u53BB\u68EE\u6797\u5427\u3002"
    dialogueLines: []
    setObjectiveOnComplete: 1
    objectiveTextOnComplete: "\u524D\u5F80\u68EE\u6797\uFF0C\u8ABF\u67E5\u4E94\u8272\u5BF6\u5149"
    advanceQuestStageOnComplete: 1
    questStageOnComplete: 4
  useSpeakerLines: 0
  speakerLines: []
  dialogueLines:
  - "\u4F60\u56DE\u4F86\u4E86\u3002\u4ECA\u5929\u6BD4\u5E73\u5E38\u665A\u4E9B\u3002"
  - "\u4F60\u4E0D\u662F\u4ECA\u5929\u7B2C\u4E00\u500B\u5E36\u4F86\u58DE\u6D88\u606F\u7684\u4EBA\u3002"
  - "\u6751\u88E1\u5E7E\u500B\u5E74\u8F15\u4EBA\uFF0C\u4ECA\u5929\u65E9\u4E0A\u5728\u68EE\u6797\u5916\u570D\u9047\u5230\u5927\u91CF\u5C0F\u602A\u3002"
  - "\u4ED6\u5011\u73FE\u5728\u90FD\u5728\u9152\u9928\u990A\u50B7\u548C\u58D3\u9A5A\u3002"
  - "\u5148\u53BB\u9152\u9928\u554F\u6E05\u695A\uFF0C\u4E0D\u8981\u81EA\u5DF1\u4E00\u982D\u947D\u9032\u68EE\u6797\u6DF1\u8655\u3002"
  fontSize: 20
  dialogueBackgroundColor: {r: 0, g: 0, b: 0, a: 0.78}
  speakerColor: {r: 1, g: 0.86, b: 0.45, a: 1}
  setObjectiveOnComplete: 0
  objectiveTextOnComplete: "\u524D\u5F80\u9152\u9928\uFF0C\u8A62\u554F\u53D7\u50B7\u7684\u5E74\u8F15\u4EBA"
