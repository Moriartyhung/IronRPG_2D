  - "\u7CBE\u82F1\u602A"
  - "\u4E3B\u89D2"
  - "\u7CBE\u82F1\u602A"
  dialogueLines:
  - "\u505C\u4E0B\u3002"
  - "\u4F60\u6703\u8AAA\u8A71\uFF1F"
  - "\u6211\u9084\u6703\u6BBA\u4EBA\u3002\u4F60\u8981\u5148\u807D\u54EA\u4E00\u500B\uFF1F"
  - "\u6211\u53EA\u60F3\u77E5\u9053\u4F60\u5B88\u8457\u90A3\u500B\u7BB1\u5B50\u505A\u4EC0\u9EBC\u3002"
  - "\u4EBA\u985E\u7E3D\u662F\u9019\u6A23\u3002\u770B\u898B\u5149\uFF0C\u5C31\u4EE5\u70BA\u88E1\u9762\u7684\u6771\u897F\u8A72\u5C6C\u65BC\u81EA\u5DF1\u3002"
  - "\u68EE\u6797\u88E1\u7684\u5C0F\u602A\u662F\u4F60\u6D3E\u51FA\u53BB\u7684\uFF1F"
  - "\u662F\u3002"
  - "\u6751\u6C11\u53D7\u50B7\u4E5F\u662F\u56E0\u70BA\u4F60\uFF1F"
  - "\u5F31\u8005\u95D6\u9032\u72E9\u7375\u5834\uFF0C\u88AB\u54AC\u50B7\u5F88\u5947\u602A\u55CE\uFF1F"
  - "\u9019\u7247\u68EE\u6797\u4E0D\u662F\u4F60\u7684\u3002"
  - "\u5F88\u5FEB\u5C31\u662F\u4E86\u3002"
  - "\u4F60\u662F\u6D1E\u7A74 Boss \u7684\u624B\u4E0B\uFF1F"
  - "\u66FE\u7D93\u662F\u3002"
  - "\u66FE\u7D93\uFF1F"
  - "\u90A3\u982D\u8001\u602A\u7269\u8EB2\u5728\u6D1E\u88E1\u592A\u4E45\u4E86\u3002\u5B83\u66FE\u7D93\u8B93\u6240\u6709\u6771\u897F\u8DEA\u4E0B\uFF0C\u4F46\u73FE\u5728\uFF0C\u5B83\u53EA\u662F\u4E00\u5177\u9760\u6050\u61FC\u652F\u6490\u7684\u6B98\u8EC0\u3002"
  - "\u6240\u4EE5\u4F60\u80CC\u53DB\u5B83\u3002"
  - "\u6211\u7A31\u4E4B\u70BA\u53D6\u4EE3\u3002"
  - "\u68EE\u6797\u7570\u5E38\u662F\u4F60\u9020\u6210\u7684\uFF1F"
  - "\u6211\u53EA\u662F\u62FF\u56DE\u672C\u8A72\u5C6C\u65BC\u5F37\u8005\u7684\u6A5F\u6703\u3002"
  - "\u96F7\u75D5\u7B26\u6587\uFF1F"
  - "\u4F60\u77E5\u9053\u5B83\uFF1F"
  - "\u807D\u8AAA\u904E\u3002"
  - "\u5B83\u539F\u672C\u5C01\u5728\u6D1E\u7A74\u6DF1\u8655\uFF0C\u50CF\u4E00\u9846\u71C3\u8457\u96F7\u7684\u91D8\u5B50\uFF0C\u58D3\u8457\u90A3\u982D\u8001\u602A\u7269\u7684\u529B\u91CF\u3002"
  - "\u4F60\u62D4\u8D70\u4E86\u5B83\u3002"
  - "\u6211\u62D4\u8D70\u4E86\u5B83\u3002\u6D1E\u7A74\u56E0\u6B64\u9707\u52D5\uFF0C\u90A3\u8001\u602A\u7269\u56E0\u6B64\u9192\u4F86\u3002"
  - "\u6240\u4EE5\u4E0D\u662F\u90A3\u4E9B\u5E74\u8F15\u4EBA\u9A5A\u9192 Boss\u3002"
  - "\u5E74\u8F15\u4EBA\uFF1F\u90A3\u4E9B\u5728\u6D1E\u53E3\u5C16\u53EB\u7684\u5E7C\u5D3D\uFF1F"
  - "\u4F60\u77E5\u9053\u4ED6\u5011\uFF1F"
  - "\u4ED6\u5011\u5435\u9192\u4E0D\u4E86\u771F\u6B63\u7684\u707D\u5384\u3002\u4F46\u4ED6\u5011\u8B93\u6211\u77E5\u9053\uFF0C\u4EBA\u985E\u53C8\u958B\u59CB\u9760\u8FD1\u7981\u5730\u3002"
  - "\u4F60\u62D4\u8D70\u7B26\u6587\u5F8C\uFF0CBoss \u8FFD\u6BBA\u4F60\uFF1F"
  - "\u5B83\u53CD\u61C9\u5F88\u5FEB\u3002\u6BD4\u6211\u5E0C\u671B\u7684\u5FEB\u3002"
  - "\u4F60\u7684\u624B\u4E0B\u5462\uFF1F"
  - "\u6B7B\u4E86\u4E00\u534A\u3002"
  - "\u5269\u4E0B\u7684\u5462\uFF1F"
  - "\u73FE\u5728\u6B78\u6211\u3002"
  - "\u5305\u62EC\u68EE\u6797\u88E1\u7684\u5C0F\u602A\uFF1F"
  - "\u5B83\u5011\u5BB3\u6015\u6211\uFF0C\u6240\u4EE5\u670D\u5F9E\u6211\u3002"
  - "\u4F60\u5F97\u5230\u96F7\u75D5\u7B26\u6587\u4E86\uFF1F"
  - "\u6211\u596A\u5F97\u4E86\u5B83\uFF0C\u537B\u9084\u6C92\u6709\u5F97\u5230\u5B83\u7684\u627F\u8A8D\u3002"
  - "\u5B83\u62D2\u7D55\u4E86\u4F60\u3002"
  - "\u5B83\u6703\u5C48\u670D\u3002"
  - "\u807D\u8D77\u4F86\u4E0D\u50CF\u3002"
  - "\u9589\u5634\u3002"
  - "\u4F60\u6D3E\u5C0F\u602A\u963B\u64CB\u5176\u4ED6\u4EBA\u9760\u8FD1\uFF0C\u662F\u6015\u6709\u4EBA\u6BD4\u4F60\u5148\u88AB\u5B83\u627F\u8A8D\uFF1F"
  - "\u6211\u662F\u9632\u6B62\u8822\u8CA8\u9001\u6B7B\u3002"
  - "\u771F\u9AD4\u8CBC\u3002"
  - "\u4F60\u5F88\u5F37\u3002\u6BD4\u90A3\u4E9B\u54ED\u558A\u8457\u9003\u8DD1\u7684\u4EBA\u985E\u5F37\u3002"
  - "\u4F60\u60F3\u8AAA\u4EC0\u9EBC\uFF1F"
  - "\u81E3\u670D\u6211\u3002"
  - "\u2026\u2026"
  - "\u8DDF\u6211\u4E00\u8D77\u63A8\u7FFB\u6D1E\u7A74\u88E1\u90A3\u982D\u8001\u602A\u7269\u3002\u7B49\u6211\u6BBA\u4E86\u5B83\uFF0C\u6211\u6703\u6210\u70BA\u65B0\u7684\u738B\u3002\u5230\u6642\u5019\uFF0C\u6211\u53EF\u4EE5\u8B93\u4F60\u6D3B\u8457\u3002"
  - "\u807D\u8D77\u4F86\u689D\u4EF6\u4E0D\u932F\u3002\u53EA\u662F\u6709\u4E00\u9EDE\u3002"
  - "\u4EC0\u9EBC\uFF1F"
  - "\u6211\u4E0D\u559C\u6B61\u7576\u602A\u7269\u7684\u624B\u4E0B\u3002"
  - "\u90A3\u5C31\u7528\u8840\u8B49\u660E\u4F60\u7684\u9AA8\u6C23\u3002"
  - "\u6211\u6703\u5148\u628A\u4F60\u6253\u5012\uFF0C\u518D\u770B\u90A3\u679A\u7B26\u6587\u9858\u4E0D\u9858\u610F\u627F\u8A8D\u6211\u3002"
  - "\u90A3\u5C31\u4F86\u3002"
  pauseEnemiesWhileOpen: 1
