  - speakerName: "\u9152\u9928\u8001\u95C6"
    text: "\u54CE\uFF0C\u4F60\u4F86\u5F97\u6B63\u597D\u3002\u90A3\u5E7E\u500B\u5B69\u5B50\u5F9E\u68EE\u6797\u56DE\u4F86\u5F8C\uFF0C\u5C31\u4E00\u76F4\u5750\u5728\u89D2\u843D\u88E1\u3002"
