  - speakerName: "\u9152\u9928\u8001\u95C6"
    text: "\u76AE\u8089\u50B7\u5C45\u591A\uFF0C\u4F46\u5687\u5F97\u4E0D\u8F15\u3002\u6D1B\u514B\u90A3\u5C0F\u5B50\u5230\u73FE\u5728\u676F\u5B50\u90FD\u62FF\u4E0D\u7A69\u3002"
  - speakerName: "\u4E3B\u89D2"
    text: "\u6751\u9577\u8B93\u6211\u4F86\u554F\u4ED6\u5011\u68EE\u6797\u7684\u4E8B\u3002"
  - speakerName: "\u9152\u9928\u8001\u95C6"
    text: "\u90A3\u4F60\u53EF\u5F97\u6709\u8010\u5FC3\u3002\u4ED6\u5011\u4ECA\u5929\u8AAA\u8A71\u50CF\u5634\u88E1\u585E\u4E86\u6FD5\u5E03\u3002"
