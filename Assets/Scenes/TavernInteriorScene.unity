      text: "\u6211\u6703\u8A66\u8A66\u3002"
    - speakerName: "\u9152\u9928\u8001\u95C6"
      text: "\u9084\u6709\uFF0C\u5225\u628A\u684C\u5B50\u7838\u58DE\u3002\u4E0A\u6B21\u4F60\u5011\u6BD4\u8155\u529B\uFF0C\u90A3\u5F35\u684C\u5B50\u5230\u73FE\u5728\u9084\u6B6A\u8457\u3002"
