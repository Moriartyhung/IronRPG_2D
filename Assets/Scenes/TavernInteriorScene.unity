  - speakerName: "\u4E3B\u89D2"
    text: "\u6211\u554F\u7684\u662F\u60C5\u5831\uFF0C\u4E0D\u662F\u4F60\u7684\u7AAE\u3002"
  - speakerName: "\u963F\u68EE"
    text: "\u597D\u5427\uFF0C\u6211\u5011\u662F\u6BD4\u5E73\u5E38\u63A1\u96C6\u9EDE\u518D\u9760\u6DF1\u8655\u4E00\u9EDE\uFF0C\u4F46\u9084\u6C92\u771F\u7684\u9032\u6DF1\u6797\u3002"
  - speakerName: "\u4E3B\u89D2"
    text: "\u963F\u68EE\u3002"
  - speakerName: "\u963F\u68EE"
    text: "\u597D\u5427\uFF0C\u662F\u7C73\u5A1C\u5148\u770B\u5230\u90A3\u908A\u6709\u5149\uFF0C\u50CF\u5BF6\u77F3\uFF0C\u53C8\u50CF\u706B\uFF0C\u4E94\u984F\u516D\u8272\u5730\u9583\u3002"
  - speakerName: "\u4E3B\u89D2"
    text: "\u7136\u5F8C\u602A\u7269\u5C31\u51FA\u73FE\u4E86\uFF1F"
  - speakerName: "\u963F\u68EE"
    text: "\u5148\u662F\u543C\u8072\u3002\u5F88\u4F4E\uFF0C\u5F88\u6C89\uFF0C\u50CF\u5F9E\u5730\u5E95\u4E0B\u6EFE\u4E0A\u4F86\u3002"
  - speakerName: "\u4E3B\u89D2"
    text: "\u4F60\u5011\u6709\u770B\u5230\u5E36\u982D\u7684\u602A\u7269\u55CE\uFF1F"
  - speakerName: "\u963F\u68EE"
    text: "\u6C92\u6709\u3002\u4E5F\u53EF\u80FD\u770B\u5230\u4E86\uFF0C\u4F46\u6211\u5011\u7576\u6642\u53EA\u9867\u8457\u8DD1\u3002"
  - speakerName: "\u4E3B\u89D2"
    text: "\u771F\u96E3\u5F97\uFF0C\u4F60\u4E5F\u6703\u627F\u8A8D\u81EA\u5DF1\u8DD1\u4E86\u3002"
  - speakerName: "\u963F\u68EE"
    text: "\u6703\u8DD1\u624D\u80FD\u6D3B\u8457\u5750\u5728\u9019\u88E1\uFF0C\u88AB\u4F60\u5BE9\u554F\u3002"
  dialogueLines:
  - "\u55B2\uFF0C\u662F\u4F60\u554A\u3002\u6751\u9577\u6D3E\u4F60\u4F86\u7684\uFF1F"
  - "\u68EE\u6797\u7684\u4E8B\uFF1F\u6C92\u4EC0\u9EBC\u597D\u554F\u7684\uFF0C\u5C31\u662F\u5012\u9709\u3002"
  - "\u597D\u5427\uFF0C\u6211\u5011\u662F\u6BD4\u5E73\u5E38\u63A1\u96C6\u9EDE\u518D\u9760\u6DF1\u8655\u4E00\u9EDE\uFF0C\u4F46\u9084\u6C92\u771F\u7684\u9032\u6DF1\u6797\u3002"
  - "\u7C73\u5A1C\u5148\u770B\u5230\u90A3\u908A\u6709\u5149\uFF0C\u50CF\u5BF6\u77F3\uFF0C\u53C8\u50CF\u706B\uFF0C\u4E94\u984F\u516D\u8272\u5730\u9583\u3002"
  - "\u7136\u5F8C\u5C31\u50B3\u4F86\u5F88\u4F4E\u7684\u543C\u8072\uFF0C\u50CF\u5F9E\u5730\u5E95\u4E0B\u6EFE\u4E0A\u4F86\u3002"
  - "\u5C0F\u602A\u63A5\u8457\u5F9E\u8349\u53E2\u3001\u6A39\u5F8C\u548C\u77F3\u982D\u5F8C\u9762\u947D\u51FA\u4F86\u3002\u6211\u5011\u53EA\u9867\u8457\u8DD1\uFF0C\u6C92\u770B\u6E05\u695A\u662F\u4E0D\u662F\u6709\u5E36\u982D\u7684\u3002"
  fontSize: 20
  dialogueBackgroundColor: {r: 0, g: 0, b: 0, a: 0.78}
  speakerColor: {r: 1, g: 0.86, b: 0.45, a: 1}
  setObjectiveOnComplete: 0
