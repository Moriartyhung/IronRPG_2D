  dialogueLines:
  - "\u4F60\u4E5F\u770B\u5230\u907A\u8DE1\u9644\u8FD1\u7684\u5C0F\u602A\u4E86\u55CE\uFF1F\u4F60\u9032\u9580\u6642\u7684\u81C9\u8272\uFF0C\u548C\u6211\u5011\u5DEE\u4E0D\u591A\u3002"
  - "\u963F\u68EE\u8AAA\u7684\u5BF6\u5149\u662F\u771F\u7684\u3002\u5728\u68EE\u6797\u5F88\u6DF1\u7684\u5730\u65B9\uFF0C\u4E0D\u50CF\u706B\u5149\uFF0C\u4E5F\u4E0D\u50CF\u9B54\u7269\u773C\u775B\u3002"
  - "\u90A3\u5149\u6709\u597D\u5E7E\u7A2E\u984F\u8272\uFF0C\u50CF\u8584\u9727\u4E00\u6A23\u5F9E\u6A39\u7E2B\u88E1\u900F\u51FA\u4F86\u3002"
  - "\u6211\u89BA\u5F97\u5B83\u4E0D\u662F\u666E\u901A\u5BF6\u7269\uFF0C\u5B83\u50CF\u662F\u5728\u5438\u5F15\u6211\u5011\u3002"
  - "\u5F8C\u4F86\u7684\u543C\u8072\u4E5F\u4E0D\u50CF\u5F9E\u68EE\u6797\u88E1\u4F86\uFF0C\u66F4\u50CF\u662F\u6D1E\u7A74\u65B9\u5411\u3002"
  - "\u6211\u5011\u78BA\u5BE6\u9760\u8FD1\u904E\u6D1E\u7A74\u9580\u53E3\uFF0C\u4F46\u771F\u7684\u6C92\u6709\u9032\u53BB\u3002"
  - "\u6709\u4EBA\u5728\u6D1E\u53E3\u558A\u4E86\u5E7E\u8072\uFF0C\u7B2C\u4E09\u8072\u4E4B\u5F8C\uFF0C\u6D1E\u88E1\u50CF\u6709\u4EC0\u9EBC\u6771\u897F\u7FFB\u8EAB\u3002"
  - "\u6751\u9577\u4E0D\u77E5\u9053\u9019\u4EF6\u4E8B\u3002\u4F60\u8981\u56DE\u53BB\u544A\u8A34\u4ED6\uFF1F\u5B8C\u4E86\uFF0C\u6211\u5011\u5927\u6982\u8981\u4FEE\u4E09\u500B\u6708\u67F5\u6B04\u3002"
