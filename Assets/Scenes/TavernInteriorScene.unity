      text: "\u6211\u9084\u6C92\u554F\u3002"
    - speakerName: "\u6D1B\u514B"
      text: "\u90A3\u4F60\u4E0D\u8981\u554F\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4F60\u5011\u53BB\u904E\u6D1E\u7A74\u9580\u53E3\uFF0C\u5C0D\u5427\uFF1F"
    - speakerName: "\u6D1B\u514B"
      text: "\u8AB0\u8AAA\u7684\uFF1F"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4F60\u5011\u4E09\u500B\u6BCF\u500B\u4EBA\u90FD\u9732\u4E86\u4E00\u9EDE\u3002"
    - speakerName: "\u6D1B\u514B"
      text: "\u6211\u5C31\u77E5\u9053\u963F\u68EE\u90A3\u5F35\u5634\u9760\u4E0D\u4F4F\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6240\u4EE5\u662F\u771F\u7684\u3002"
    - speakerName: "\u6D1B\u514B"
      text: "\u6211\u5011\u6C92\u6709\u9032\u53BB\uFF01\u53EA\u662F\u53BB\u6D1E\u7A74\u9580\u53E3\u6253\u9B27\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4F60\u5011\u5728\u7981\u5730\u9580\u53E3\u5927\u558A\u5927\u53EB\uFF0C\u9019\u53EB\u6253\u9B27\uFF1F"
    - speakerName: "\u6D1B\u514B"
      text: "\u963F\u68EE\u8AAA\u53EA\u8981\u5728\u6D1E\u53E3\u558A\u4E00\u8072\uFF0C\u5982\u679C\u6C92\u6709\u6771\u897F\u56DE\u61C9\uFF0C\u5C31\u8B49\u660E\u6751\u9577\u53EA\u662F\u5687\u552C\u4EBA\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u7136\u5F8C\u5462\uFF1F"
    - speakerName: "\u6D1B\u514B"
      text: "\u4ED6\u558A\u4E86\u4E09\u8072\u3002\u7B2C\u4E09\u8072\u4E4B\u5F8C\uFF0C\u6D1E\u88E1\u50B3\u4F86\u8072\u97F3\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4EC0\u9EBC\u8072\u97F3\uFF1F"
    - speakerName: "\u6D1B\u514B"
      text: "\u50CF\u5F88\u5927\u7684\u6771\u897F\u5728\u7FFB\u8EAB\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6240\u4EE5\u6751\u9577\u4E0D\u77E5\u9053\u6D1E\u7A74\u7684\u4E8B\u60C5\uFF1F"
    - speakerName: "\u6D1B\u514B"
      text: "\u4E0D\u77E5\u9053\u3002\u4F60\u4E0D\u80FD\u544A\u8A34\u4ED6\uFF0C\u4ED6\u6703\u6BBA\u4E86\u6211\u5011\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u4E0D\u6703\u3002\u4F46\u4ED6\u53EF\u80FD\u6703\u8B93\u4F60\u5011\u4FEE\u4E09\u500B\u6708\u67F5\u6B04\u3002"
    - speakerName: "\u6D1B\u514B"
      text: "\u90A3\u9084\u4E0D\u5982\u6BBA\u4E86\u6211\u3002"
    - speakerName: "\u4E3B\u89D2"
      text: "\u6211\u6703\u8DDF\u4ED6\u8AAA\u5BE6\u60C5\u3002"
    - speakerName: "\u6D1B\u514B"
      text: "\u5B8C\u4E86\u3002"
    dialogueLines: []
    setObjectiveOnComplete: 1
    objectiveTextOnComplete: "\u56DE\u6751\u9577\u5BB6\uFF0C\u56DE\u5831\u6D1E\u7A74\u7DDA\u7D22"
