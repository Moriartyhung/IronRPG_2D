    - speakerName: "\u9152\u9928\u8001\u95C6"
      text: "\u76AE\u8089\u50B7\u5C45\u591A\uFF0C\u4F46\u5687\u5F97\u4E0D\u8F15\u3002\u6D1B\u514B\u90A3\u5C0F\u5B50\u5230\u73FE\u5728\u676F\u5B50\u90FD\u62FF\u4E0D\u7A69\u3002"
